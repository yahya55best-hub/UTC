# ─────────────────────────────────────────────────────────────────────────────
# UTC CPQ — frontend environment variables
# Copy this file to `.env` and fill in your Supabase project values.
# Only the ANON key belongs in the browser. NEVER put the service_role key here.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project "anon" / "public" API key (safe for the browser).
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — used by the seed script (scripts/seed.mjs), never by the app.
# Keep this secret. Do not expose it in the frontend / do not prefix with VITE_.
# Find it in: Supabase Dashboard → Project Settings → API → service_role key.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
